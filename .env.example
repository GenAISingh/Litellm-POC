# Copy this file to .env and fill in the values. Never commit .env.
# Values already filled in below are non-secret defaults that match docker-compose.yml.

# --- PostgreSQL (LiteLLM database) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=litellm

# --- Redis (shared router state) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Azure OpenAI / Microsoft Foundry ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Groq ---
GROQ_API_KEY=

# --- Self-hosted Gemma (vLLM, OpenAI-compatible) ---
GEMMA_API_KEY=
# Base URL ending in /v1. Use https:// so the key and prompts are encrypted in transit.
GEMMA_API_BASE=

# --- OpenTelemetry (LiteLLM traces to the collector, then Azure Monitor) ---
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=litellm-gateway
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=poc,service.namespace=llm-gateway
AZURE_MONITOR_CONNECTION_STRING=

# --- Chainlit UI ---
# Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET=
APP_USERNAME=
APP_PASSWORD=
# LiteLLM virtual key the UI uses (never the master key). Create it once the proxy is up;
# see "Set up" in README.md.
CHAINLIT_LITELLM_API_KEY=

# --- LiteLLM keys ---
# Master key must start with sk-. Example generator: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
# Salt key encrypts credentials stored in the database. Set it once and never change it.
LITELLM_SALT_KEY=

# --- Caddy ---
# Public hostname that Caddy serves the Chainlit UI on (for example <name>.<region>.cloudapp.azure.com)
GATEWAY_HOSTNAME=
